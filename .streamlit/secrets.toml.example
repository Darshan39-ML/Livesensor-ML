# Example secrets for Streamlit Cloud or local development
# Do NOT commit real secrets to the repo. Use Streamlit's Secrets manager or environment variables.

# MongoDB connection string (e.g. from Atlas)
# MONGODB_URI = "mongodb+srv://user:password@cluster0.mongodb.net/dbname?retryWrites=true&w=majority"

# Optional: APP host/port for FastAPI (if using FastAPI backend)
# APP_HOST = "0.0.0.0"
# APP_PORT = "8080"

# Any other secrets used by your app
# EXAMPLE_SECRET = "value"
